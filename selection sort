#include <iostream>
using namespace std;
// time complexity is O(n^2) in worst , average case.//
void Selection_sort(int arr[], int n)
{
          int min;
          for (int i = 0; i < n - 1; i++)
          {
                    min = i;
                    for (int j = i + 1; j < n; j++)
                    {
                              if (arr[j] < arr[min])
                                        min = j;
                    }
                    if (min == i)
                    {
                              break;
                    }
                    else
                    {
                              swap(arr[i], arr[min]);
                    }
          }
}
int main()
{
          int n;
          cout << "Enter the number of element :  ";
          cin >> n;
          cout << "Enter the elment \n";
          int ar[n];
          for (int i = 0; i < n; i++)
          {
                    cin >> ar[i];
          }
          Selection_sort(ar, n);
          for (int i = 0; i < n; i++)
          {
                    cout << ar[i] << " ";
          }
}
