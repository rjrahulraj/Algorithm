#include <iostream>
using namespace std;

// Time complexity of worst and Average case is O(n^2) and Time complexity of best case(Already sorted in ascending order) is O(n).

void Insertion_sort(int arr[], int n)
{
          for (int i = 1; i < n; i++)
          {
                    int temp = arr[i];
                    int j = i - 1;
                    while (j >= 0 && arr[j] > temp)
                    {
                              arr[j + 1] = arr[j];
                              j--;
                    }
                    arr[j + 1] = temp;
          }
}
int main()
{
          int n;
          cout << "Enter the number of element :  ";
          cin >> n;
          cout << "Enter the elment \n";
          int ar[n];
          for (int i = 0; i < n; i++)
          {
                    cout << i + 1 << " value : ";
                    cin >> ar[i];
          }
          Insertion_sort(ar, n);
          for (int i = 0; i < n; i++)
          {
                    cout << ar[i] << " ";
          }
          return 0;
}
